<Page
    x:Class="PowerToolbox.Views.Pages.ContextMenuManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:class="using:PowerToolbox.Extensions.DataType.Class"
    xmlns:converter="using:PowerToolbox.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="using:PowerToolbox.Extensions.DataType.Enums"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:PowerToolbox.Models"
    xmlns:rootservice="using:PowerToolbox.Services.Root"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <class:ExecuteCommand x:Name="CheckBoxClickCommand" ExecuteRequested="{x:Bind OnCheckBoxClickExecuteRequested}" />
        <class:ExecuteCommand x:Name="OpenPackagePathCommand" ExecuteRequested="{x:Bind OnOpenPackagePathExecuteRequested}" />
    </Page.Resources>

    <SplitView
        x:Name="ContextMenuSplitView"
        DisplayMode="Overlay"
        OpenPaneLength="320"
        PaneBackground="Transparent"
        PanePlacement="Right">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  右键菜单管理控制栏  -->
            <CommandBar
                Grid.Row="0"
                Margin="24,7,22,-5"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Center"
                Background="Transparent"
                CommandBarOverflowPresenterStyle="{StaticResource CommandBarOverflowPresenterWithSystemBackdropStyle}"
                DefaultLabelPosition="Collapsed"
                IsDynamicOverflowEnabled="False">

                <CommandBar.Content>
                    <Grid Margin="0,0,12,0">
                        <Grid
                            Grid.Row="0"
                            MinWidth="100"
                            MinHeight="32"
                            HorizontalAlignment="Left">

                            <Rectangle
                                Fill="{ThemeResource PillItemBackgroundSelected}"
                                RadiusX="16"
                                RadiusY="16"
                                Stroke="{ThemeResource PillItemBorderBrushSelected}"
                                StrokeThickness="1" />

                            <TextBlock
                                Padding="16,4,16,6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource PillItemForegroundSelected}"
                                Text="{x:Bind rootservice:ResourceService.ContextMenuManagerResource.GetString('ContextMenuManager')}" />
                        </Grid>

                        <Grid HorizontalAlignment="Right">
                            <InfoBadge
                                Style="{StaticResource InformationalValueInfoBadgeStyle}"
                                ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.ContextMenuManagerResource.GetString('ContextMenuEmpty')}"
                                Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityReverseConvert(ContextMenuCollection.Count), Mode=OneWay}"
                                Value="{x:Bind ContextMenuCollection.Count, Mode=OneWay}" />

                            <InfoBadge
                                ToolTipService.ToolTip="{x:Bind x:String.Format(ContextMenuCountInfoString, ContextMenuCollection.Count), Mode=OneWay}"
                                Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(ContextMenuCollection.Count), Mode=OneWay}"
                                Value="{x:Bind ContextMenuCollection.Count, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </CommandBar.Content>

                <CommandBar.PrimaryCommands>
                    <AppBarButton
                        Width="48"
                        IsEnabled="{x:Bind GetIsLoading(ContextMenuResultKind), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.ContextMenuManagerResource.GetString('SearchContextMenu')}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE721;" />
                        </AppBarButton.Icon>

                        <AppBarButton.Flyout>
                            <Flyout
                                x:Name="WinGetSearchFlyout"
                                Placement="Bottom"
                                ShouldConstrainToRootBounds="False">

                                <Flyout.FlyoutPresenterStyle>
                                    <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>

                                <Grid>
                                    <SystemBackdropElement CornerRadius="{StaticResource OverlayCornerRadius}" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />

                                    <AutoSuggestBox
                                        Width="200"
                                        Margin="5,0,5,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        AllowFocusOnInteraction="True"
                                        IsEnabled="{x:Bind GetIsLoading(ContextMenuResultKind), Mode=OneWay}"
                                        PlaceholderText="{x:Bind rootservice:ResourceService.ContextMenuManagerResource.GetString('SearchAppNamePHText')}"
                                        QuerySubmitted="{x:Bind OnQuerySubmitted}"
                                        Text="{x:Bind SearchText, Mode=OneWay}"
                                        TextChanged="{x:Bind OnTextChanged}">

                                        <AutoSuggestBox.QueryIcon>
                                            <FontIcon FontSize="14" Glyph="&#xE71E;" />
                                        </AutoSuggestBox.QueryIcon>
                                    </AutoSuggestBox>
                                </Grid>
                            </Flyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <AppBarButton
                        Width="48"
                        Click="{x:Bind OnRefreshClicked}"
                        IsEnabled="{x:Bind GetIsLoading(ContextMenuResultKind), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.ContextMenuManagerResource.GetString('Refresh')}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE72C;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        Width="48"
                        Click="{x:Bind OnRestoreDefaultClicked}"
                        IsEnabled="{x:Bind GetIsLoading(ContextMenuResultKind), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.ContextMenuManagerResource.GetString('RestoreDefault')}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE7A7;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.PrimaryCommands>

                <CommandBar.SecondaryCommands>
                    <AppBarButton Click="{x:Bind OnUseInstructionClicked}" Label="{x:Bind rootservice:ResourceService.ContextMenuManagerResource.GetString('UseInstruction')}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE946;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>

            <Grid Grid.Row="1">
                <!--  右键菜单状态显示  -->
                <Grid
                    Margin="30,0,30,60"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind GetContextMenuSuccessfullyVisibility(ContextMenuResultKind, x:False), Mode=OneWay}">

                    <!--  正在加载中  -->
                    <StackPanel Spacing="20" Visibility="{x:Bind CheckContextMenuResultKindVisibility(ContextMenuResultKind, enum:ContextMenuResultKind.Loading), Mode=OneWay}">
                        <Image
                            Width="150"
                            Height="150"
                            Source="ms-appx:///Assets/Image/Search.png" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ProgressRing
                                Grid.Column="0"
                                Width="30"
                                Height="30"
                                IsActive="True" />

                            <TextBlock
                                Grid.Column="1"
                                MaxWidth="800"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="Medium"
                                Text="{x:Bind rootservice:ResourceService.ContextMenuManagerResource.GetString('LoadingContextMenuInformation')}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>

                    <!--  加载失败（包含搜索结果为空）  -->
                    <StackPanel Spacing="20" Visibility="{x:Bind CheckContextMenuResultKindVisibility(ContextMenuResultKind, enum:ContextMenuResultKind.Failed), Mode=OneWay}">
                        <Image
                            Width="150"
                            Height="150"
                            Source="ms-appx:///Assets/Image/Failed.png" />

                        <TextBlock
                            MaxWidth="800"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Medium"
                            Text="{x:Bind ContextMenuFailedContent, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!--  右键菜单结果展示项目控件  -->
                <ListView
                    Padding="30,0,28,30"
                    ItemsSource="{x:Bind ContextMenuCollection}"
                    SelectionMode="None"
                    Visibility="{x:Bind GetContextMenuSuccessfullyVisibility(ContextMenuResultKind, x:True), Mode=OneWay}">

                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0 " />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ItemsControl.ItemContainerTransitions>
                        <TransitionCollection />
                    </ItemsControl.ItemContainerTransitions>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="model:ContextMenuModel">
                            <Expander
                                Margin="0,0,0,2"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                IsExpanded="False">

                                <Expander.Header>
                                    <Grid Height="60">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid
                                            Grid.Column="0"
                                            Width="30"
                                            Height="30"
                                            Margin="0,0,12,0"
                                            Padding="2"
                                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource ControlCornerRadius}">
                                            <ImageIcon Source="{x:Bind PackageIcon}" />
                                        </Grid>

                                        <StackPanel
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Orientation="Vertical">

                                            <TextBlock
                                                x:Name="PackageDisplayNameTextBlock"
                                                HorizontalAlignment="Left"
                                                IsTextSelectionEnabled="True"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                Text="{x:Bind PackageDisplayName}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap">

                                                <ToolTipService.ToolTip>
                                                    <ToolTip Content="{x:Bind PackageDisplayName}" Visibility="{Binding ElementName=PackageDisplayNameTextBlock, Path=IsTextTrimmed, Mode=OneWay}" />
                                                </ToolTipService.ToolTip>
                                            </TextBlock>

                                            <TextBlock
                                                x:Name="PackageFullNameTextBlock"
                                                HorizontalAlignment="Left"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                IsTextSelectionEnabled="True"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind PackageFullName}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap">

                                                <ToolTipService.ToolTip>
                                                    <ToolTip Content="{x:Bind PackageFullName}" Visibility="{Binding ElementName=PackageFullNameTextBlock, Path=IsTextTrimmed, Mode=OneWay}" />
                                                </ToolTipService.ToolTip>
                                            </TextBlock>
                                        </StackPanel>

                                        <Button
                                            Grid.Column="2"
                                            Width="32"
                                            Height="32"
                                            Margin="5,0,0,0"
                                            Padding="0"
                                            Command="{StaticResource OpenPackagePathCommand}"
                                            CommandParameter="{x:Bind PackagePath}"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.ContextMenuManagerResource.GetString('OpenPackagePath')}">

                                            <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                                        </Button>
                                    </Grid>
                                </Expander.Header>

                                <ListView ItemsSource="{x:Bind ContextMenuItemCollection}" SelectionMode="None">

                                    <ListView.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="MinHeight" Value="0 " />
                                        </Style>
                                    </ListView.ItemContainerStyle>

                                    <ItemsControl.ItemContainerTransitions>
                                        <TransitionCollection />
                                    </ItemsControl.ItemContainerTransitions>

                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="model:ContextMenuItemModel">
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox
                                                    Grid.Column="0"
                                                    MinWidth="0"
                                                    Margin="4,0,9,0"
                                                    Command="{StaticResource CheckBoxClickCommand}"
                                                    CommandParameter="{x:Bind}"
                                                    IsChecked="{x:Bind IsEnabled, Mode=OneWay}" />

                                                <TextBlock
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{x:Bind ClsidString}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Expander>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <SplitView.Pane>
            <!--  使用说明  -->
            <Grid Margin="0,10,0,0" CornerRadius="4,0,0,0">
                <SystemBackdropElement CornerRadius="4,0,0,0" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            Margin="16,2,6,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Glyph="&#xE946;" />

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="{x:Bind rootservice:ResourceService.ContextMenuManagerResource.GetString('UseInstruction')}" />

                        <Button
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="{x:Bind OnCloseClicked}"
                            Style="{StaticResource AlternateCloseButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.ContextMenuManagerResource.GetString('Close')}">

                            <FontIcon
                                Margin="4"
                                FontSize="16"
                                Glyph="&#xE711;" />
                        </Button>
                    </Grid>

                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Visible"
                        VerticalScrollMode="Enabled">

                        <Grid Margin="0,0,0,30">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Margin="16,10,16,10"
                                FontSize="15"
                                FontWeight="Normal"
                                Text="{x:Bind rootservice:ResourceService.ContextMenuManagerResource.GetString('MenuInstruction')}"
                                TextAlignment="Left" />

                            <TextBlock
                                Grid.Row="1"
                                Margin="16,0,16,5"
                                FontSize="14"
                                FontWeight="Normal"
                                Text="{x:Bind rootservice:ResourceService.ContextMenuManagerResource.GetString('MenuInstructionContent1')}"
                                TextAlignment="Justify"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="2"
                                Margin="16,0,16,5"
                                FontSize="14"
                                FontWeight="Normal"
                                Text="{x:Bind rootservice:ResourceService.ContextMenuManagerResource.GetString('MenuInstructionContent2')}"
                                TextAlignment="Justify"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="3"
                                Margin="16,0,16,5"
                                FontSize="14"
                                FontWeight="Normal"
                                Text="{x:Bind rootservice:ResourceService.ContextMenuManagerResource.GetString('MenuInstructionContent3')}"
                                TextAlignment="Justify"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="4"
                                Margin="16,0,16,5"
                                FontSize="14"
                                FontWeight="Normal"
                                Text="{x:Bind rootservice:ResourceService.ContextMenuManagerResource.GetString('MenuInstructionContent4')}"
                                TextAlignment="Justify"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="5"
                                Margin="16,0,16,5"
                                FontSize="14"
                                FontWeight="Normal"
                                Text="{x:Bind rootservice:ResourceService.ContextMenuManagerResource.GetString('MenuInstructionContent5')}"
                                TextAlignment="Justify"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="6"
                                Margin="16,0,16,5"
                                FontSize="14"
                                FontWeight="Normal"
                                Text="{x:Bind rootservice:ResourceService.ContextMenuManagerResource.GetString('MenuInstructionContent6')}"
                                TextAlignment="Justify"
                                TextWrapping="Wrap" />

                            <StackPanel
                                Grid.Row="7"
                                Margin="16,0,16,5"
                                Spacing="5">

                                <TextBlock HorizontalAlignment="Left">
                                    <Hyperlink NavigateUri="https://blogs.windows.com/windowsdeveloper/2021/07/19/extending-the-context-menu-and-share-dialog-in-windows-11" UnderlineStyle="None">
                                        <Run Text="{x:Bind rootservice:ResourceService.ContextMenuManagerResource.GetString('LearnCustomRightClickMenu')}" />
                                    </Hyperlink>
                                </TextBlock>

                                <TextBlock HorizontalAlignment="Left">
                                    <Hyperlink Click="{x:Bind OnOpenSettingsClicked}" UnderlineStyle="None">
                                        <Run Text="{x:Bind rootservice:ResourceService.ContextMenuManagerResource.GetString('OpenSettings')}" />
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </SplitView.Pane>
    </SplitView>
</Page>
