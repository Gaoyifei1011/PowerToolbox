<Page
    x:Class="PowerToolbox.Views.Pages.DataVerifyEncryptPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:PowerToolbox.Models"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <CornerRadius x:Key="ListViewItemCornerRadius">0</CornerRadius>

        <TransitionCollection x:Name="SuppressNavigationTransitionCollection">
            <NavigationThemeTransition>
                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    <SuppressNavigationTransitionInfo />
                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
            </NavigationThemeTransition>
        </TransitionCollection>

        <TransitionCollection x:Name="LeftSlideNavigationTransitionCollection">
            <NavigationThemeTransition>
                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    <SlideNavigationTransitionInfo Effect="FromLeft" />
                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
            </NavigationThemeTransition>
        </TransitionCollection>

        <TransitionCollection x:Name="RightSlideNavigationTransitionCollection">
            <NavigationThemeTransition>
                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    <SlideNavigationTransitionInfo Effect="FromRight" />
                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
            </NavigationThemeTransition>
        </TransitionCollection>
    </Page.Resources>

    <SplitView
        x:Name="DataVerifyEncryptSplitView"
        DisplayMode="Overlay"
        OpenPaneLength="400"
        PaneBackground="Transparent"
        PanePlacement="Right">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  数据校验与加密解密控制栏  -->
            <RadioButtons
                Margin="30,17,0,3"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Canvas.ZIndex="1"
                ItemsSource="{x:Bind DataVerifyEncryptSelectorRadioList}"
                SelectedIndex="{x:Bind SelectedIndex, Mode=OneWay}"
                SelectionChanged="{x:Bind OnSelectionChanged}"
                Style="{StaticResource HorizontalRadioButtonsStyle}">

                <RadioButtons.Resources>
                    <Thickness x:Key="RadioButtonsTopHeaderMargin">0</Thickness>
                </RadioButtons.Resources>

                <RadioButtons.ItemTemplate>
                    <DataTemplate x:DataType="model:RadioButtonItemModel">
                        <RadioButton Content="{x:Bind SelectorName}" Style="{StaticResource PillRadioButtonStyle}" />
                    </DataTemplate>
                </RadioButtons.ItemTemplate>
            </RadioButtons>

            <Frame
                x:Name="DataVerifyEncryptFrame"
                Grid.Row="1"
                Margin="30,0,0,0"
                NavigationFailed="{x:Bind OnNavigationFailed}" />
        </Grid>
    </SplitView>
</Page>
