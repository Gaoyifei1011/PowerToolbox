<Page
    x:Class="PowerToolbox.Views.Pages.DriverManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animation="using:PowerToolbox.Views.Animations"
    xmlns:class="using:PowerToolbox.Extensions.DataType.Classes"
    xmlns:converter="using:PowerToolbox.Helpers.Converters"
    xmlns:customcontrol="using:PowerToolbox.Views.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="using:PowerToolbox.Extensions.DataType.Enums"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:PowerToolbox.Models"
    xmlns:roothelper="using:PowerToolbox.Helpers.Root"
    xmlns:rootservice="using:PowerToolbox.Services.Root"
    xmlns:system="using:System"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <class:ExecuteCommand x:Name="DeleteDriverCommand" ExecuteRequested="{x:Bind OnDeleteDriverExecuteRequested}" />
        <class:ExecuteCommand x:Name="ForceDeleteDriverCommand" ExecuteRequested="{x:Bind OnForceDeleteDriverExecuteRequested}" />
        <class:ExecuteCommand x:Name="OpenFolderCommand" ExecuteRequested="{x:Bind OnOpenFolderExecuteRequested}" />
        <class:ExecuteCommand x:Name="RemoveTaskCommand" ExecuteRequested="{x:Bind OnRemoveTaskExecuteRequested}" />
    </Page.Resources>

    <SplitView
        x:Name="DriverSplitView"
        DisplayMode="Overlay"
        PaneBackground="Transparent"
        PanePlacement="Right">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  驱动管理控制栏  -->
            <CommandBar
                Grid.Row="0"
                Margin="24,8,22,-5"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Center"
                Background="Transparent"
                CommandBarOverflowPresenterStyle="{StaticResource CommandBarOverflowPresenterWithSystemBackdropStyle}"
                DefaultLabelPosition="Collapsed"
                IsDynamicOverflowEnabled="False">

                <CommandBar.Content>
                    <Grid Margin="0,1,12,0">
                        <Grid
                            Grid.Row="0"
                            MinWidth="100"
                            MinHeight="32"
                            HorizontalAlignment="Left">

                            <Rectangle
                                Fill="{ThemeResource PillItemBackgroundSelected}"
                                RadiusX="16"
                                RadiusY="16"
                                Stroke="{ThemeResource PillItemBorderBrushSelected}"
                                StrokeThickness="1" />

                            <TextBlock
                                Padding="16,4,16,6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource PillItemForegroundSelected}"
                                Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('DriverManager')}" />
                        </Grid>

                        <Grid HorizontalAlignment="Right">
                            <InfoBadge
                                Style="{StaticResource InformationalValueInfoBadgeStyle}"
                                ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('DriverEmpty')}"
                                Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityReverseConvert(DriverCollection.Count), Mode=OneWay}"
                                Value="{x:Bind DriverCollection.Count, Mode=OneWay}" />

                            <InfoBadge
                                ToolTipService.ToolTip="{x:Bind x:String.Format(DriverCountInfoString, DriverCollection.Count, SelectedItemsCount), Mode=OneWay}"
                                Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(DriverCollection.Count), Mode=OneWay}"
                                Value="{x:Bind DriverCollection.Count, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </CommandBar.Content>

                <CommandBar.PrimaryCommands>
                    <AppBarButton
                        Width="48"
                        IsEnabled="{x:Bind GetIsLoadingOrOperating(DriverResultKind), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('MultiSelect')}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE762;" />
                        </AppBarButton.Icon>

                        <AppBarButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem
                                    Click="{x:Bind OnSelectAllClicked}"
                                    IsEnabled="{x:Bind GetIsLoadingOrOperating(DriverResultKind), Mode=OneWay}"
                                    Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('SelectAll')}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B3;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem
                                    Click="{x:Bind OnSelectNoneClicked}"
                                    IsEnabled="{x:Bind GetIsLoadingOrOperating(DriverResultKind), Mode=OneWay}"
                                    Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('SelectNone')}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8E6;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem Click="{x:Bind OnSelectReverseClicked}" Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('SelectReverse')}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEA98;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <AppBarButton
                        Width="48"
                        IsEnabled="{x:Bind GetIsLoadingOrOperating(DriverResultKind), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('Sort')}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8CB;" />
                        </AppBarButton.Icon>

                        <AppBarButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutSubItem Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('SortWay')}">

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSortWayClicked}"
                                        GroupName="SortWayRadioGroup"
                                        IsChecked="{x:Bind IsIncrease, Mode=OneWay}"
                                        Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('SortIncrease')}">

                                        <RadioMenuFlyoutItem.Tag>
                                            <x:Boolean>True</x:Boolean>
                                        </RadioMenuFlyoutItem.Tag>
                                    </RadioMenuFlyoutItem>

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSortWayClicked}"
                                        GroupName="SortWayRadioGroup"
                                        IsChecked="{x:Bind converter:ValueConverterHelper.BooleanReverseConvert(IsIncrease), Mode=OneWay}"
                                        Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('SortDecrease')}">

                                        <RadioMenuFlyoutItem.Tag>
                                            <x:Boolean>False</x:Boolean>
                                        </RadioMenuFlyoutItem.Tag>
                                    </RadioMenuFlyoutItem>
                                </MenuFlyoutSubItem>

                                <MenuFlyoutSubItem Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('SortRule')}">
                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSortRuleClicked}"
                                        GroupName="SortRuleRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedDriverSortRuleKind, enum:DriverSortRuleKind.DeviceName), Mode=OneWay}"
                                        Tag="{x:Bind enum:DriverSortRuleKind.DeviceName}"
                                        Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('SortByDeviceName')}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSortRuleClicked}"
                                        GroupName="SortRuleRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedDriverSortRuleKind, enum:DriverSortRuleKind.InfName), Mode=OneWay}"
                                        Tag="{x:Bind enum:DriverSortRuleKind.InfName}"
                                        Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('SortByInfName')}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSortRuleClicked}"
                                        GroupName="SortRuleRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedDriverSortRuleKind, enum:DriverSortRuleKind.OEMInfName), Mode=OneWay}"
                                        Tag="{x:Bind enum:DriverSortRuleKind.OEMInfName}"
                                        Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('SortByOEMInfName')}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSortRuleClicked}"
                                        GroupName="SortRuleRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedDriverSortRuleKind, enum:DriverSortRuleKind.DeviceType), Mode=OneWay}"
                                        Tag="{x:Bind enum:DriverSortRuleKind.DeviceType}"
                                        Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('SortByDeviceType')}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSortRuleClicked}"
                                        GroupName="SortRuleRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedDriverSortRuleKind, enum:DriverSortRuleKind.Manufacturer), Mode=OneWay}"
                                        Tag="{x:Bind enum:DriverSortRuleKind.Manufacturer}"
                                        Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('SortByManufacturer')}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSortRuleClicked}"
                                        GroupName="SortRuleRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedDriverSortRuleKind, enum:DriverSortRuleKind.Version), Mode=OneWay}"
                                        Tag="{x:Bind enum:DriverSortRuleKind.Version}"
                                        Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('SortByVersion')}" />

                                    <RadioMenuFlyoutItem
                                        Click="{x:Bind OnSortRuleClicked}"
                                        GroupName="SortRuleRadioGroup"
                                        IsChecked="{x:Bind x:Object.Equals(SelectedDriverSortRuleKind, enum:DriverSortRuleKind.Date), Mode=OneWay}"
                                        Tag="{x:Bind enum:DriverSortRuleKind.Date}"
                                        Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('SortByDate')}" />
                                </MenuFlyoutSubItem>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <AppBarButton
                        Width="48"
                        Click="{x:Bind OnTaskManagerClicked}"
                        ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('TaskManager')}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE71D;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.PrimaryCommands>

                <CommandBar.SecondaryCommands>
                    <AppBarButton
                        Click="{x:Bind OnRefreshClicked}"
                        IsEnabled="{x:Bind GetIsLoadingOrOperating(DriverResultKind), Mode=OneWay}"
                        Label="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('Refresh')}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE72C;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarSeparator />

                    <AppBarButton
                        Click="{x:Bind OnAddDriverClicked}"
                        IsEnabled="{x:Bind GetElevatedIsLoadingOrOperating(DriverResultKind), Mode=OneWay}"
                        Label="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('AddDriver')}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE710;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        Click="{x:Bind OnAddInstallDriverClicked}"
                        IsEnabled="{x:Bind GetElevatedIsLoadingOrOperating(DriverResultKind), Mode=OneWay}"
                        Label="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('AddInstallDriver')}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE710;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        Click="{x:Bind OnDeleteDriverClicked}"
                        IsEnabled="{x:Bind GetElevatedIsLoadingOrOperating(DriverResultKind), Mode=OneWay}"
                        Label="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('DeleteDriver')}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE711;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        Click="{x:Bind OnForceDeleteDriverClicked}"
                        IsEnabled="{x:Bind GetElevatedIsLoadingOrOperating(DriverResultKind), Mode=OneWay}"
                        Label="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('ForceDeleteDriver')}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE711;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarSeparator />

                    <AppBarButton
                        Click="{x:Bind OnSelectOldDriverClicked}"
                        IsEnabled="{x:Bind GetIsLoadingOrOperating(DriverResultKind), Mode=OneWay}"
                        Label="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('SelectOldDriver')}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE74D;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarSeparator />

                    <AppBarButton Click="{x:Bind OnUseInstructionClicked}" Label="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('UseInstruction')}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE946;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton Click="{x:Bind OnOpenDeviceManagementClicked}" Label="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('DeviceManagement')}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE7F8;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  驱动管理状态显示  -->
                <Grid
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="30,0,30,60"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind GetDriverHasResultVisibility(DriverResultKind, x:True), Mode=OneWay}">

                    <!--  正在加载中  -->
                    <StackPanel Spacing="20" Visibility="{x:Bind CheckDriverResultKindVisibility(DriverResultKind, enum:DriverResultKind.Loading), Mode=OneWay}">
                        <AnimatedVisualPlayer
                            x:Name="LoadingVisualPlayer"
                            Width="120"
                            Height="120">
                            <animation:AnimatedLoadingVisualSource />
                        </AnimatedVisualPlayer>

                        <TextBlock
                            MaxWidth="800"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Medium"
                            Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('LoadingDriver')}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  加载失败（包含搜索结果为空）  -->
                    <StackPanel Spacing="20" Visibility="{x:Bind CheckDriverResultKindVisibility(DriverResultKind, enum:DriverResultKind.Failed), Mode=OneWay}">
                        <Image
                            Width="120"
                            Height="120"
                            Source="ms-appx:///Assets/Image/Failed.png" />

                        <TextBlock
                            MaxWidth="800"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Medium"
                            Text="{x:Bind DriverFailedContent, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!--  驱动管理结果展示项目控件  -->
                <ListView
                    x:Name="DriverManagerListView"
                    Grid.Row="0"
                    Padding="30,0,28,30"
                    IsEnabled="{x:Bind GetIsOperating(DriverResultKind), Mode=OneWay}"
                    ItemsSource="{x:Bind DriverCollection}"
                    SelectionChanged="{x:Bind OnSelectionChanged}"
                    SelectionMode="Multiple"
                    Visibility="{x:Bind GetDriverHasResultVisibility(DriverResultKind, x:False), Mode=OneWay}">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                            <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{ThemeResource ListViewItemForeground}" />
                            <Setter Property="TabNavigation" Value="Local" />
                            <Setter Property="IsHoldingEnabled" Value="True" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="30" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="MinWidth" Value="{ThemeResource ListViewItemMinWidth}" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="AllowDrop" Value="False" />
                            <Setter Property="UseSystemFocusVisuals" Value="True" />
                            <Setter Property="FocusVisualMargin" Value="1" />
                            <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource ListViewItemFocusVisualPrimaryBrush}" />
                            <Setter Property="FocusVisualPrimaryThickness" Value="2" />
                            <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource ListViewItemFocusVisualSecondaryBrush}" />
                            <Setter Property="FocusVisualSecondaryThickness" Value="1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <customcontrol:ExpanderListViewItemPresenter
                                            x:Name="Root"
                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                            CheckBoxBorderBrush="{ThemeResource ListViewItemCheckBoxBorderBrush}"
                                            CheckBoxBrush="{ThemeResource ListViewItemCheckBoxBrush}"
                                            CheckBoxCornerRadius="{ThemeResource ListViewItemCheckBoxCornerRadius}"
                                            CheckBoxDisabledBorderBrush="{ThemeResource ListViewItemCheckBoxDisabledBorderBrush}"
                                            CheckBoxDisabledBrush="{ThemeResource ListViewItemCheckBoxDisabledBrush}"
                                            CheckBoxPointerOverBorderBrush="{ThemeResource ListViewItemCheckBoxPointerOverBorderBrush}"
                                            CheckBoxPointerOverBrush="{ThemeResource ControlAltFillColorTertiaryBrush}"
                                            CheckBoxPressedBorderBrush="{ThemeResource ListViewItemCheckBoxPressedBorderBrush}"
                                            CheckBoxPressedBrush="{ThemeResource ListViewItemCheckBoxPressedBrush}"
                                            CheckBoxSelectedBrush="{ThemeResource ListViewItemCheckBoxSelectedBrush}"
                                            CheckBoxSelectedDisabledBrush="{ThemeResource ListViewItemCheckBoxSelectedDisabledBrush}"
                                            CheckBoxSelectedPointerOverBrush="{ThemeResource ListViewItemCheckBoxSelectedPointerOverBrush}"
                                            CheckBoxSelectedPressedBrush="{ThemeResource ListViewItemCheckBoxSelectedPressedBrush}"
                                            CheckBrush="{ThemeResource ListViewItemCheckBrush}"
                                            CheckDisabledBrush="{ThemeResource ListViewItemCheckDisabledBrush}"
                                            CheckMode="{ThemeResource ListViewItemCheckMode}"
                                            CheckPressedBrush="{ThemeResource ListViewItemCheckPressedBrush}"
                                            ContentMargin="{TemplateBinding Padding}"
                                            ContentTransitions="{TemplateBinding ContentTransitions}"
                                            Control.IsTemplateFocusTarget="True"
                                            CornerRadius="{ThemeResource ListViewItemCornerRadius}"
                                            DisabledOpacity="{ThemeResource ListViewItemDisabledThemeOpacity}"
                                            DragBackground="{ThemeResource ListViewItemDragBackground}"
                                            DragForeground="{ThemeResource ListViewItemDragForeground}"
                                            DragOpacity="{ThemeResource ListViewItemDragThemeOpacity}"
                                            FocusBorderBrush="{ThemeResource ListViewItemFocusBorderBrush}"
                                            FocusSecondaryBorderBrush="{ThemeResource ListViewItemFocusSecondaryBorderBrush}"
                                            FocusVisualMargin="{TemplateBinding FocusVisualMargin}"
                                            FocusVisualPrimaryBrush="{TemplateBinding FocusVisualPrimaryBrush}"
                                            FocusVisualPrimaryThickness="{TemplateBinding FocusVisualPrimaryThickness}"
                                            FocusVisualSecondaryBrush="{TemplateBinding FocusVisualSecondaryBrush}"
                                            FocusVisualSecondaryThickness="{TemplateBinding FocusVisualSecondaryThickness}"
                                            PlaceholderBackground="{ThemeResource ListViewItemPlaceholderBackground}"
                                            PointerOverBackground="Transparent"
                                            PointerOverForeground="{ThemeResource ListViewItemForegroundPointerOver}"
                                            PressedBackground="Transparent"
                                            ReorderHintOffset="{ThemeResource ListViewItemReorderHintThemeOffset}"
                                            SelectedBackground="Transparent"
                                            SelectedDisabledBackground="Transparent"
                                            SelectedForeground="{ThemeResource ListViewItemForegroundSelected}"
                                            SelectedPointerOverBackground="Transparent"
                                            SelectedPressedBackground="Transparent"
                                            SelectionCheckMarkVisualEnabled="{ThemeResource ListViewItemSelectionCheckMarkVisualEnabled}"
                                            SelectionIndicatorBrush="{ThemeResource ListViewItemSelectionIndicatorBrush}"
                                            SelectionIndicatorCornerRadius="{ThemeResource ListViewItemSelectionIndicatorCornerRadius}"
                                            SelectionIndicatorDisabledBrush="{ThemeResource ListViewItemSelectionIndicatorDisabledBrush}"
                                            SelectionIndicatorPointerOverBrush="{ThemeResource ListViewItemSelectionIndicatorPointerOverBrush}"
                                            SelectionIndicatorPressedBrush="{ThemeResource ListViewItemSelectionIndicatorPressedBrush}"
                                            SelectionIndicatorVisualEnabled="{ThemeResource ListViewItemSelectionIndicatorVisualEnabled}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="model:DriverModel">
                            <Expander
                                Margin="-28,0,0,2"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                IsExpanded="False"
                                Style="{StaticResource ExpanderListViewStyle}">

                                <Expander.Header>
                                    <Grid Height="60">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Orientation="Vertical">

                                            <TextBlock
                                                x:Name="DeviceNameTextBlock"
                                                HorizontalAlignment="Left"
                                                IsTextSelectionEnabled="True"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                Text="{x:Bind DeviceName}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap">

                                                <ToolTipService.ToolTip>
                                                    <ToolTip Content="{x:Bind DeviceName}" Visibility="{Binding ElementName=DeviceNameTextBlock, Path=IsTextTrimmed, Mode=OneWay}" />
                                                </ToolTipService.ToolTip>
                                            </TextBlock>

                                            <TextBlock
                                                x:Name="DriverManufacturerTextBlock"
                                                HorizontalAlignment="Left"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                IsTextSelectionEnabled="True"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind DriverManufacturer}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap">

                                                <ToolTipService.ToolTip>
                                                    <ToolTip Content="{x:Bind DriverManufacturer}" Visibility="{Binding ElementName=DriverManufacturerTextBlock, Path=IsTextTrimmed, Mode=OneWay}" />
                                                </ToolTipService.ToolTip>
                                            </TextBlock>
                                        </StackPanel>

                                        <Button
                                            Grid.Column="1"
                                            MinHeight="{ThemeResource AppBarThemeCompactHeight}"
                                            Margin="-6,0,-15,0"
                                            Padding="{ThemeResource CommandBarMoreButtonMargin}"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource CommandBarForeground}"
                                            IsAccessKeyScope="True"
                                            Style="{ThemeResource EllipsisButton}"
                                            ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('ViewMore')}">

                                            <FontIcon
                                                Height="{ThemeResource AppBarExpandButtonCircleDiameter}"
                                                VerticalAlignment="Center"
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                FontSize="20"
                                                Glyph="&#xE712;" />

                                            <Button.Flyout>
                                                <MenuFlyout Placement="Bottom">
                                                    <MenuFlyoutItem
                                                        Command="{StaticResource OpenFolderCommand}"
                                                        CommandParameter="{x:Bind DriverLocation}"
                                                        Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('OpenFolder')}">

                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>

                                                    <MenuFlyoutSeparator />

                                                    <MenuFlyoutItem
                                                        Command="{StaticResource DeleteDriverCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        IsEnabled="{x:Bind roothelper:RuntimeHelper.IsElevated}"
                                                        Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('DeleteDriver')}">

                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon FontSize="14" Glyph="&#xE711;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>

                                                    <MenuFlyoutItem
                                                        Command="{StaticResource ForceDeleteDriverCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        IsEnabled="{x:Bind roothelper:RuntimeHelper.IsElevated}"
                                                        Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('ForceDeleteDriver')}">

                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon FontSize="14" Glyph="&#xE711;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </Expander.Header>

                                <Grid
                                    Margin="40,0,0,0"
                                    ColumnSpacing="15"
                                    RowSpacing="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        FontSize="14"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('DriverInfName')}" />

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        FontSize="14"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind DriverInfName}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        FontSize="14"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('DriverOEMInfName')}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        FontSize="14"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind DriverOEMInfName}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        FontSize="14"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('DriverType')}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        FontSize="14"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind DriverType}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        FontSize="14"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('DriverVersion')}" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        FontSize="14"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind system:Convert.ToString(DriverVersion)}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        FontSize="14"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('DriverDate')}" />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        FontSize="14"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind DriverDate.ToString('yyyy/MM/dd')}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        FontSize="14"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('DriverSize')}" />

                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        FontSize="14"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind DriverSize}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="6"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        FontSize="14"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('SignatureName')}" />

                                    <TextBlock
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        FontSize="14"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind SignatureName}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Expander>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--  正在操作中  -->
                <Grid
                    Grid.Row="1"
                    Margin="30,5,30,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ColumnSpacing="15"
                    Visibility="{x:Bind CheckDriverResultKindVisibility(DriverResultKind, enum:DriverResultKind.Operating), Mode=OneWay}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar
                        Grid.Column="0"
                        Width="150"
                        IsIndeterminate="True" />

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('Operating')}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </Grid>

        <SplitView.Pane>
            <Grid>
                <Grid Margin="0,10,0,0" CornerRadius="4,0,0,0">
                    <SystemBackdropElement CornerRadius="4,0,0,0" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />

                    <!--  使用说明  -->
                    <Grid Visibility="{x:Bind CheckDriverPaneKindVisibility(DriverPaneKind, enum:DriverPaneKind.UseInstruction), Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid
                            Grid.Row="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Column="0"
                                Margin="16,0,6,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Glyph="&#xE946;" />

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('UseInstruction')}" />

                            <Button
                                Grid.Column="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="{x:Bind OnCloseClicked}"
                                Style="{StaticResource AlternateCloseButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('Close')}">

                                <FontIcon
                                    Margin="4"
                                    FontSize="16"
                                    Glyph="&#xE711;" />
                            </Button>
                        </Grid>

                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Visible"
                            VerticalScrollMode="Enabled">

                            <Grid Margin="0,0,0,30">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Margin="16,10,16,10"
                                    FontSize="15"
                                    FontWeight="Normal"
                                    Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('DriverInstruction')}"
                                    TextAlignment="Left" />

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="16,0,16,5"
                                    FontSize="14"
                                    FontWeight="Normal"
                                    Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('DriverDescriptionContent1')}"
                                    TextAlignment="Justify"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Grid.Row="2"
                                    Margin="16,0,16,5"
                                    FontSize="14"
                                    FontWeight="Normal"
                                    Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('DriverDescriptionContent2')}"
                                    TextAlignment="Justify"
                                    TextWrapping="Wrap" />

                                <StackPanel
                                    Grid.Row="4"
                                    Margin="16,0,16,5"
                                    Spacing="5">

                                    <TextBlock HorizontalAlignment="Left">
                                        <Hyperlink NavigateUri="https://learn.microsoft.com/windows-hardware/drivers/kernel/introduction-to-plug-and-play" UnderlineStyle="None">
                                            <Run Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('LearnPnpDriver')}" />
                                        </Hyperlink>
                                    </TextBlock>

                                    <TextBlock HorizontalAlignment="Left">
                                        <Hyperlink Click="{x:Bind OnRunAsAdministratorClicked}" UnderlineStyle="None">
                                            <Run Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('RunAsAdministrator')}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!--  任务管理  -->
                    <Grid Visibility="{x:Bind CheckDriverPaneKindVisibility(DriverPaneKind, enum:DriverPaneKind.TaskManager), Mode=OneWay}">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid
                            Grid.Row="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Column="0"
                                Margin="16,0,6,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Glyph="&#xE71D;" />

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('TaskManager')}" />

                            <InfoBadge
                                Grid.Column="2"
                                Margin="6,2,0,0"
                                HorizontalAlignment="Left"
                                Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(DriverOperationCollection.Count), Mode=OneWay}"
                                Value="{x:Bind DriverOperationCollection.Count, Mode=OneWay}" />

                            <Button
                                Grid.Column="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="{x:Bind OnClearDriverOperationTaskClicked}"
                                IsEnabled="{x:Bind system:Convert.ToBoolean(DriverOperationCollection.Count), Mode=OneWay}"
                                Style="{StaticResource AlternateCloseButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('ClearDriverOperationTask')}">

                                <FontIcon
                                    Margin="4"
                                    FontSize="16"
                                    Glyph="&#xE74D;" />
                            </Button>

                            <Button
                                Grid.Column="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="{x:Bind OnCloseClicked}"
                                Style="{StaticResource AlternateCloseButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('Close')}">

                                <FontIcon
                                    Margin="4"
                                    FontSize="16"
                                    Glyph="&#xE711;" />
                            </Button>
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityReverseConvert(DriverOperationCollection.Count), Mode=OneWay}">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Image
                                Grid.Row="0"
                                Width="120"
                                Height="120"
                                Source="ms-appx:///Assets/Image/NoTask.png" />

                            <TextBlock
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('DriverOperationTaskEmpty')}"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords" />
                        </Grid>

                        <ListView
                            Grid.Row="1"
                            Margin="0,2,0,0"
                            Padding="0,0,0,30"
                            ItemsSource="{x:Bind DriverOperationCollection}"
                            SelectionMode="None"
                            Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(DriverOperationCollection.Count), Mode=OneWay}">

                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="model:DriverOperationModel">
                                    <Grid
                                        Height="60"
                                        Margin="2,0,2,2"
                                        Padding="16,0,6,0"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ControlCornerRadius}">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            RowSpacing="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock
                                                x:Name="DriverInfNameTextBlock"
                                                Grid.Row="0"
                                                MinWidth="50"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Text="{x:Bind DriverInfName}"
                                                TextAlignment="Left"
                                                TextTrimming="CharacterEllipsis">

                                                <ToolTipService.ToolTip>
                                                    <ToolTip Content="{x:Bind DriverInfName}" Visibility="{Binding ElementName=DriverInfNameTextBlock, Path=IsTextTrimmed, Mode=OneWay}" />
                                                </ToolTipService.ToolTip>
                                            </TextBlock>

                                            <TextBlock
                                                x:Name="DriverOperationTextBlock"
                                                Grid.Row="1"
                                                MinWidth="50"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Text="{x:Bind DriverOperation, Mode=OneWay}"
                                                TextAlignment="Left"
                                                TextTrimming="CharacterEllipsis">

                                                <ToolTipService.ToolTip>
                                                    <ToolTip Content="{x:Bind DriverOperation, Mode=OneWay}" Visibility="{Binding ElementName=DriverOperationTextBlock, Path=IsTextTrimmed, Mode=OneWay}" />
                                                </ToolTipService.ToolTip>
                                            </TextBlock>
                                        </Grid>

                                        <ProgressRing
                                            Grid.Column="1"
                                            Width="20"
                                            Height="20"
                                            Margin="10,0,8,0"
                                            IsActive="True"
                                            Visibility="{x:Bind IsOperating, Mode=OneWay}" />

                                        <Button
                                            Grid.Column="1"
                                            Width="Auto"
                                            Height="Auto"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Command="{StaticResource RemoveTaskCommand}"
                                            CommandParameter="{x:Bind DriverOperationGuid}"
                                            Style="{StaticResource AlternateCloseButtonStyle}"
                                            ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.DriverManagerResource.GetString('RemoveTask')}"
                                            Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsOperating), Mode=OneWay}">

                                            <FontIcon
                                                Margin="4"
                                                FontSize="16"
                                                Glyph="&#xE711;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Grid>
        </SplitView.Pane>
    </SplitView>
</Page>
